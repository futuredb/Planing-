# Copy to .env.openrouter.local (gitignored). Never put keys in VITE_* variables.
OPENROUTER_API_KEY=
# Optional HTTP CONNECT proxy. Applies only to OpenRouter requests.
OPENROUTER_PROXY_URL=
# Exact model ID with Responses API, JSON Schema and tool support. No :online or auto.
FUNBAN_OPENROUTER_MODEL=
# Legacy setting, currently unused: automatic draft questions are disabled.
FUNBAN_OPENROUTER_CLARIFY_MODEL=
FUNBAN_OPENROUTER_MAX_TOKENS=8192
FUNBAN_OPENROUTER_TIMEOUT_MS=180000
# Dedicated key's credit limit must not exceed this amount (USD).
FUNBAN_OPENROUTER_MAX_KEY_LIMIT_USD=5
FUNBAN_TRENDWATCH_MODE=openrouter
# Explicitly enable the service; non-loopback additionally requires production
# and FUNBAN_OPENROUTER_SERVER=1. Local preview sets ENABLED itself.
FUNBAN_TRENDWATCH_ENABLED=0
FUNBAN_OPENROUTER_SERVER=0
FUNBAN_TRENDWATCH_WEB=1
FUNBAN_TRENDWATCH_CONCEPTS=1
# AI launches are manual-only. Legacy AUTO=1 only retains free overdue-card maintenance.
FUNBAN_TRENDWATCH_AUTO=0
FUNBAN_LOCAL_PORT=4338
