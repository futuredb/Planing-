{
  "name": "funban",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "start": "node server.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "test:e2e": "npm run build && playwright test",
    "test:mcp": "node --test tests/mcp.test.mjs",
    "test:trendwatch": "node --test tests/trendwatch.test.mjs tests/codex.test.mjs tests/quick.test.mjs tests/clarifier.test.mjs tests/openrouter.test.mjs tests/trendwatch-config.test.mjs tests/openrouter-server.test.mjs tests/openrouter-clarifier.test.mjs",
    "dev:local": "npm run build && node scripts/local-preview.mjs",
    "preview:checks": "npm run build && node tests/preview-server.mjs",
    "check:openrouter": "node --env-file-if-exists=.env.openrouter.local scripts/check-openrouter.mjs",
    "dev:openrouter": "npm run build && node --env-file=.env.openrouter.local scripts/local-preview.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "undici": "8.12.4",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.4"
  }
}
